# Clé API Google Gemini (optionnel, pour l'IA générative)
# Obtenez-en une gratuitement sur : https://aistudio.google.com/
GEMINI_API_KEY=

# Modèle Gemini à utiliser (défaut: gemini-2.5-flash)
GEMINI_MODEL=gemini-2.5-flash

# Si vous préférez un LLM local Ollama (décommentez pour activer)
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

# Activer l'IA pour TOUS les messages privés par défaut (true/false)
AI_AUTO_REPLY=false

# Numéro par défaut pour le Pairing Code (optionnel, format international sans '+' ex: 33612345678)
PHONE_NUMBER=